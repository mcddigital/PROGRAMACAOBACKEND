{
  "info": {
    "name": "DevShowcase API",
    "_postman_id": "devshowcase-api-etapa-final",
    "description": "Coleção para testar os endpoints exigidos nas etapas do projeto DevShowcase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Profiles",
      "item": [
        {
          "name": "Cadastrar perfil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Daniel de Macedo Silva\",\n  \"email\": \"daniel@example.com\",\n  \"bio\": \"Desenvolvedor\",\n  \"githubUrl\": \"https://github.com/mcddigital\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profiles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profiles"
              ]
            }
          }
        },
        {
          "name": "Buscar perfil por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/profiles/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profiles",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Technologies",
      "item": [
        {
          "name": "Cadastrar tecnologia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Java\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/technologies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "technologies"
              ]
            }
          }
        },
        {
          "name": "Listar tecnologias",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/technologies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "technologies"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Cadastrar projeto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"DevShowcase API\",\n  \"description\": \"API de portfólio de desenvolvedores\",\n  \"repositoryUrl\": \"https://github.com/mcddigital/PROGRAMACAOBACKEND\",\n  \"profileId\": 1,\n  \"technologyIds\": [\n    1\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          }
        },
        {
          "name": "Listar projetos paginados",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar projetos por tecnologia",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?technology=Java&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ],
              "query": [
                {
                  "key": "technology",
                  "value": "Java"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Cadastrar feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorName\": \"Maria\",\n  \"rating\": 5,\n  \"comment\": \"Projeto muito bom\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/1/feedbacks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "1",
                "feedbacks"
              ]
            }
          }
        },
        {
          "name": "Dar upvote",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/projects/1/upvote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "1",
                "upvote"
              ]
            }
          }
        }
      ]
    }
  ]
}